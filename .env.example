# Google AI Studio API Key (Required for Gemini and Imagen generation)
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY="your_google_ai_studio_api_key_here"

# LINE LIFF App Configuration (Required for LIFF authentication and features)
# Create a LIFF app in LINE Developers Console: https://developers.line.biz/
NEXT_PUBLIC_LIFF_ID="your_line_liff_id_here"

# Optional AI Model Overrides
# Models: imagen-3.0-generate-002, imagen-3.0-generate-001
IMAGEN_MODEL="imagen-3.0-generate-002"
# Text Model: gemini-2.5-flash, gemini-1.5-flash
GEMINI_MODEL="gemini-2.5-flash"

# Optional LINE Messaging API (For bot/direct message sharing)
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_CHANNEL_SECRET=""
